# Copy to .env.local and fill in from your Supabase project (Project Settings -> API).
# NEVER commit .env.local. The service-role key bypasses RLS and must stay server-side.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The single account allowed to delete unfinished tournaments. Must exactly match
# the email you sign in with (case-insensitive). Leave unset and nobody can delete
# anything — the check fails closed. Server-side only; never exposed to browsers.
OWNER_EMAIL=you@example.com
